from dataclasses import dataclass, field
import math
import re
import secrets
import string
from typing import List, Tuple

# Common breached passwords & dictionary stems
COMMON_PASSWORDS = {
    "password", "pass", "123456", "12345678", "123456789", "qwerty",
    "abc123", "monkey", "letmein", "dragon", "111111", "baseball",
    "iloveyou", "trustno1", "sunshine", "master", "welcome", "shadow",
    "ashley", "football", "jesus", "michael", "ninja", "mustang", "admin",
}

# Keyboard rows for detecting spatial keyboard walks
KEYBOARD_ROWS = [
    "qwertyuiop",
    "asdfghjkl",
    "zxcvbnm",
    "1234567890",
]

# Leet-speak translation table to catch disguised weak words (e.g., "P@ssw0rd!")
LEET_MAP = str.maketrans({
    "@": "a", "4": "a",
    "8": "b",
    "3": "e",
    "6": "g",
    "1": "i", "!": "i", "|": "i",
    "0": "o",
    "$": "s", "5": "s",
    "7": "t", "+": "t",
})


@dataclass
class PasswordReport:
    password: str
    score: int                       # 0 to 5
    rating: str                      # Very Weak, Weak, Fair, Strong, Very Strong
    entropy_bits: float              # Effective entropy in bits
    crack_time_display: str          # Estimated offline fast-hash crack time
    passed_checks: List[str] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)
    suggestions: List[str] = field(default_factory=list)


def normalize_leet(text: str) -> str:
    """Converts common leet-speak substitutions to plain lowercase letters."""
    cleaned = text.lower().translate(LEET_MAP)
    return re.sub(r"[^a-z0-9]", "", cleaned)


def has_sequential_chars(password: str, min_len: int = 4) -> bool:
    """Detects ascending or descending alphabetical/numeric runs (e.g., 'abcd', '4321')."""
    lower = password.lower()
    if len(lower) < min_len:
        return False
    for i in range(len(lower) - min_len + 1):
        chunk = lower[i : i + min_len]
        if chunk.isalnum():
            diffs = [ord(chunk[j + 1]) - ord(chunk[j]) for j in range(min_len - 1)]
            if all(d == 1 for d in diffs) or all(d == -1 for d in diffs):
                return True
    return False


def has_keyboard_walk(password: str, min_len: int = 4) -> bool:
    """Detects horizontal keyboard walks like 'qwer', 'asdf', or 'poiu'."""
    lower = password.lower()
    for row in KEYBOARD_ROWS:
        rev_row = row[::-1]
        for i in range(len(row) - min_len + 1):
            sub = row[i : i + min_len]
            if sub in lower or rev_row[i : i + min_len] in lower:
                return True
    return False


def format_crack_time(seconds: float) -> str:
    """Formats seconds into a human-readable duration."""
    if seconds < 0.001:
        return "Instant (< 1 ms)"
    if seconds < 1:
        return f"{seconds * 1000:.0f} milliseconds"
    intervals: List[Tuple[str, float]] = [
        ("centuries", 31536000 * 100),
        ("years", 31536000),
        ("days", 86400),
        ("hours", 3600),
        ("minutes", 60),
        ("seconds", 1),
    ]
    for name, count in intervals:
        if seconds >= count:
            val = seconds / count
            if name == "centuries" and val > 1000:
                return "> 100,000 centuries"
            return f"{val:,.1f} {name}"
    return "Instant"


def check_password_strength(password: str) -> PasswordReport:
    """
    Evaluates password strength using character pool size, effective length,
    leet-speak dictionary checks, pattern penalties, and entropy calculation.
    """
    length = len(password)
    passed: List[str] = []
    warnings: List[str] = []
    suggestions: List[str] = []

    if length == 0:
        return PasswordReport(
            password="",
            score=0,
            rating="Empty",
            entropy_bits=0.0,
            crack_time_display="Instant",
            warnings=["Password is empty."],
            suggestions=["Enter a password of at least 12 characters."],
        )

    # 1. Character Pool Analysis
    has_lower = any(c.islower() for c in password)
    has_upper = any(c.isupper() for c in password)
    has_digit = any(c.isdigit() for c in password)
    has_symbol = any(c in string.punctuation for c in password)
    has_space = any(c.isspace() for c in password)

    pool_size = 0
    if has_lower:
        pool_size += 26
        passed.append("Lowercase")
    if has_upper:
        pool_size += 26
        passed.append("Uppercase")
    if has_digit:
        pool_size += 10
        passed.append("Digits")
    if has_symbol:
        pool_size += 32
        passed.append("Symbols")
    if has_space:
        pool_size += 1
        passed.append("Spaces")

    # Fallback for non-ASCII Unicode characters
    if pool_size == 0:
        pool_size = 100

    # 2. Pattern & Dictionary Vulnerability Detection
    effective_length = float(length)
    lower_pwd = password.lower()
    normalized = normalize_leet(password)

    # Check direct or leet-speak match against common passwords
    matched_common = False
    for word in COMMON_PASSWORDS:
        if len(word) >= 4 and (word in lower_pwd or word in normalized):
            matched_common = True
            warnings.append(f"Contains common dictionary/breached pattern ('{word}').")
            effective_length = max(1.0, effective_length - len(word) * 0.85)
            break

    # Check repeated characters (e.g., 'aaaa' or '111')
    if re.search(r"(.)\1{2,}", password):
        warnings.append("Contains repeated character sequences (e.g., 'aaa').")
        effective_length *= 0.75

    # Check sequential runs (e.g., '1234', 'abcd')
    if has_sequential_chars(password):
        warnings.append("Contains sequential characters (e.g., '1234' or 'abcd').")
        effective_length *= 0.75

    # Check keyboard walks (e.g., 'qwerty', 'asdf')
    if has_keyboard_walk(password):
        warnings.append("Contains keyboard walk pattern (e.g., 'qwerty').")
        effective_length *= 0.75

    # Penalize low unique character ratio
    unique_ratio = len(set(password)) / length
    if length >= 6 and unique_ratio < 0.5:
        warnings.append("Low character variety (many duplicate characters).")
        effective_length *= unique_ratio + 0.25

    # 3. Calculate Effective Entropy (Bits)
    entropy = effective_length * math.log2(pool_size)

    # Cap entropy if the entire password is just a trivially modified common word
    if matched_common and length <= 12:
        entropy = min(entropy, 28.0)

    # 4. Estimate Offline Crack Time (Assuming 10 Billion guesses/sec on modern GPU)
    guesses_per_sec = 1e10
    total_combinations = 2 ** entropy
    avg_seconds_to_crack = (total_combinations * 0.5) / guesses_per_sec
    crack_time_str = format_crack_time(avg_seconds_to_crack)

    # 5. Suggestions Generation
    if length < 12:
        suggestions.append("Increase length to at least 12–16 characters.")
    if not (has_upper and has_lower):
        suggestions.append("Mix uppercase and lowercase letters.")
    if not has_digit:
        suggestions.append("Include numbers in non-predictable positions.")
    if not has_symbol:
        suggestions.append("Add special characters (e.g., !@#$%^&*).")
    if matched_common:
        suggestions.append("Avoid common words even with symbol substitutions like '@' or '0'.")

    # 6. Map Entropy & Length to 0-5 Score and Rating
    if length < 6 or entropy < 25:
        score, rating = 1, "Very Weak"
    elif entropy < 38:
        score, rating = 2, "Weak"
    elif entropy < 55:
        score, rating = 3, "Fair"
    elif entropy < 75:
        score, rating = 4, "Strong"
    else:
        score, rating = 5, "Very Strong"

    return PasswordReport(
        password=password,
        score=score,
        rating=rating,
        entropy_bits=round(entropy, 1),
        crack_time_display=crack_time_str,
        passed_checks=passed,
        warnings=warnings,
        suggestions=suggestions,
    )


def generate_secure_password(length: int = 16) -> str:
    """Generates a cryptographically secure random password guaranteed to score 5/5."""
    length = max(12, length)
    alphabet = string.ascii_lowercase + string.ascii_uppercase + string.digits + "!@#$%^&*()-_=+"
    while True:
        pwd = "".join(secrets.choice(alphabet) for _ in range(length))
        report = check_password_strength(pwd)
        if report.score == 5 and not report.warnings:
            return pwd


