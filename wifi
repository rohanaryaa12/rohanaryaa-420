def parse_device_class(device_class: Optional[int]) -> Tuple[str, str, List[str]]:
    """
    Decodes Major Class, Minor Class, and Major Service Classes from a 24-bit CoD integer.
    """
    if device_class is None:
        return "Unknown", "Unknown", []

    # 1. Decode Major Service Classes (Bits 13-23)
    service_classes = [
        name for bit, name in MAJOR_SERVICE_CLASSES.items() if device_class & (1 << bit)
    ]

    # 2. Decode Major Device Class (Bits 8-12)
    major = (device_class >> 8) & 0x1F
    major_name = MAJOR_CLASSES.get(major, f"Unknown Major ({major})")

    # 3. Decode Minor Device Class (Bits 2-7)
    minor = (device_class >> 2) & 0x3F

    if major == 3:  # LAN/Network Access uses top 3 bits of minor field (bits 5-7)
        load_factor = (minor >> 3) & 0x07
        minor_name = LAN_LOAD_FACTORS.get(load_factor, "Unknown Load Factor")
    elif major == 5:  # Peripheral splits top 2 bits and bottom 4 bits
        top_role = PERIPHERAL_TOP_BITS.get((minor >> 4) & 0x03, "Unknown")
        sub_role = PERIPHERAL_SUBTYPES.get(minor & 0x0F, "Other")
        minor_name = f"{top_role} ({sub_role})" if sub_role != "Uncategorized" else top_role
    elif major == 6:  # Imaging uses bits 4-7 as a combinable bitmask
        imaging_types = []
        if minor & 0b000100:
            imaging_types.append("Display")
        if minor & 0b001000:
            imaging_types.append("Camera")
        if minor & 0b010000:
            imaging_types.append("Scanner")
        if minor & 0b100000:
            imaging_types.append("Printer")
        minor_name = ", ".join(imaging_types) if imaging_types else "Uncategorized Imaging"
    else:
        minor_name = MINOR_CLASSES.get((major, minor), f"Unknown Minor ({minor})")

    return major_name, minor_name, service_classes


def get_device_services(address: str) -> List[Dict[str, str]]:
    """Queries SDP services exposed by a target Bluetooth MAC address."""
    discovered_services = []
    try:
        raw_services = bluetooth.find_service(address=address)
        for svc in raw_services:
            name = svc.get("name")
            if isinstance(name, bytes):
                name = name.decode("utf-8", errors="replace")
            discovered_services.append({
                "name": name or "Unnamed Service",
                "protocol": str(svc.get("protocol") or "Unknown"),
                "port": str(svc.get("port") or "N/A"),
                "description": str(svc.get("description") or ""),
            })
    except bluetooth.BluetoothError as err:
        print(f"    [!] SDP query failed for {address}: {err}", file=sys.stderr)
    return discovered_services


def scan_once(duration: int, lookup_services: bool) -> List[Dict]:
    """Performs a single Bluetooth inquiry scan and returns structured results."""
    print(f"[*] Scanning for Bluetooth devices (Duration: {duration}s)...")
    raw_devices = bluetooth.discover_devices(
        duration=duration,
        lookup_names=True,
        lookup_class=True,
        flush_cache=True,
    )

    results = []
    timestamp = datetime.now().isoformat(timespec="seconds")

    for addr, name, dev_class in raw_devices:
        if isinstance(name, bytes):
            name = name.decode("utf-8", errors="replace")
        name = name or "Unknown/Hidden Name"

        major_cls, minor_cls, svc_classes = parse_device_class(dev_class)
        device_entry = {
            "timestamp": timestamp,
            "address": addr,
            "name": name,
            "raw_class_hex": f"0x{dev_class:06X}" if dev_class is not None else "N/A",
            "major_class": major_cls,
            "minor_class": minor_cls,
            "service_classes": svc_classes,
            "sdp_services": [],
        }

        if lookup_services:
            device_entry["sdp_services"] = get_device_services(addr)

        results.append(device_entry)

    return results


def display_results(devices: List[Dict], lookup_services: bool) -> None:
    """Formats and prints discovered Bluetooth devices to the console."""
    print(f"[+] Found {len(devices)} device(s).")
    if not devices:
        return

    print("-" * 68)
    for dev in devices:
        svc_str = ", ".join(dev["service_classes"]) if dev["service_classes"] else "None reported"
        print(f"[+] Device Name     : {dev['name']}")
        print(f"    MAC Address     : {dev['address']}")
        print(f"    Class of Device : {dev['raw_class_hex']} ({dev['major_class']} -> {dev['minor_class']})")
        print(f"    Capabilities    : {svc_str}")

        if lookup_services:
            sdp_list = dev["sdp_services"]
            if sdp_list:
                print(f"    SDP Services ({len(sdp_list)}):")
                for s in sdp_list:
                    print(f"      - {s['name']} [Protocol: {s['protocol']}, Port/Ch: {s['port']}]")
            else:
                print("    SDP Services    : None discovered")
        print("-" * 68)


def export_results(devices: List[Dict], json_path: Optional[str], csv_path: Optional[str]) -> None:
    """Saves scan results to JSON and/or CSV files."""
    if json_path:
        with open(json_path, "w", encoding="utf-8") as f:
            json.dump(devices, f, indent=2, ensure_ascii=False)
        print(f"[*] Exported results to JSON: {json_path}")

    if csv_path and devices:
        fieldnames = [
            "timestamp", "address", "name", "raw_class_hex",
            "major_class", "minor_class", "service_classes"
        ]
        with open(csv_path, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=fieldnames)
            writer.writeheader()
            for d in devices:
                row = {k: d[k] for k in fieldnames}
                row["service_classes"] = "; ".join(d["service_classes"])
                writer.writerow(row)
        print(f"[*] Exported results to CSV: {csv_path}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Bluetooth Classic CoD & SDP Scanner")
    parser.add_argument("-d", "--duration", type=int, default=8, help="Scan duration in seconds (default: 8)")
    parser.add_argument("-s", "--services", action="store_true", help="Enumerate SDP services per device")
    parser.add_argument("-w", "--watch", type=int, metavar="SEC", help="Rescan continuously every SEC seconds")
    parser.add_argument("--json", metavar="FILE", help="Export discovered devices to a JSON file")
    parser.add_argument("--csv", metavar="FILE", help="Export discovered devices to a CSV file")
    args = parser.parse_args()

    try:
        while True:
            devices = scan_once(duration=args.duration, lookup_services=args.services)
            display_results(devices, lookup_services=args.services)
            export_results(devices, json_path=args.json, csv_path=args.csv)

            if not args.watch:
                break
            print(f"[*] Waiting {args.watch} seconds before next scan (Press Ctrl+C to stop)...\n")
            time.sleep(args.watch)

    except KeyboardInterrupt:
        print("\n[!] Scan interrupted by user. Exiting.")
    except bluetooth.BluetoothError as err:
        print(f"[ERROR] Bluetooth stack error: {err}", file=sys.stderr)
        print("        Ensure your Bluetooth adapter is enabled and you have sufficient permissions.", file=sys.stderr)
    except Exception as err:
        print(f"[ERROR] Unexpected failure: {err}", file=sys.stderr)


if __name__ == "__main__":
    main()
